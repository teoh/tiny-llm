{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Tiny LLM: Qwen2-0.5b Week1 Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--solution", "tiny_llm",
                "--loader", "week1",
                "--model", "qwen2-0.5b",
                "--prompt", "Give me a short introduction to large language model"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Tiny LLM: Qwen2-1.5b Week1 Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--solution", "tiny_llm",
                "--loader", "week1",
                "--model", "qwen2-1.5b",
                // "--prompt", "Give me a short introduction to large language model"
                "--prompt", "Write me a short paragraph on roller coaster tycoon with the voice of a caveman using only one syllable words"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Tiny LLM: Qwen2-7b Week1 Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--solution", "tiny_llm",
                "--loader", "week1",
                "--model", "qwen2-7b",
                "--prompt", "Give me a short introduction to large language model"
                // "--prompt", "Write me a short paragraph on roller coaster tycoon with the voice of a caveman using only one syllable words"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
